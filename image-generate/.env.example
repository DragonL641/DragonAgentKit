# Image Generate - Credentials
# Copy to .dragonskills/image-generate.env and fill in values
# Only configure the providers you need

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# or use GEMINI_API_KEY as alias
# GOOGLE_IMAGE_MODEL=gemini-3-pro-image-preview

# Alibaba DashScope (https://dashscope.console.aliyun.com/)
DASHSCOPE_API_KEY=
# DASHSCOPE_IMAGE_MODEL=z-image-turbo

# Zhipu GLM (https://open.bigmodel.cn/)
GLM_API_KEY=
# GLM_IMAGE_MODEL=glm-image
